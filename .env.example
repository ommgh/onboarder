# Onboarder environment. Copy to .env.local for development.
# Only the "Core" block is required to run; every other feature switches itself off
# (with a clear message in the UI) when its keys are missing.

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:dev@localhost:54329/onboarder
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000   # https://onboarder.store in production
# Encrypts marketplace tokens and bank account numbers at rest. Falls back to AUTH_SECRET.
# Set it once and never change it: existing encrypted values become unreadable.
APP_ENCRYPTION_KEY=               # openssl rand -base64 32

# ── Sign-in providers ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (verification + contact form) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Onboarder <hello@onboarder.store>"   # must be a Resend-verified domain
CONTACT_EMAIL=                    # where contact-form messages are delivered

# ── File storage (product photos, AI images) ─────────────────────────────────
UPLOADTHING_TOKEN=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional per-purpose keys (fall back to GEMINI_API_KEY) and model overrides:
# GEMINI_DETECTION_API_KEY=
# GEMINI_GENERATION_API_KEY=
# GEMINI_MODEL_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ── Barcode lookup ────────────────────────────────────────────────────────────
# Open Food Facts is used without a key; go-upc adds wider coverage when set.
UPC_API_KEY=

# ── Payments (Dodo) ───────────────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode    # or test_mode
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_PRO_SUB=                 # product ids; keep lib/plans.ts PLAN_PRICES in sync
DODO_PAYMENTS_ENTERPRISE_SUB=
DODO_PAYMENTS_RETURN_URL=              # defaults to <app>/dashboard/settings?upgraded=1

# ── Shopify (Dev Dashboard app; redirect URL <app>/api/channels/shopify/callback) ──
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Amazon SP-API (redirect URI <app>/api/channels/amazon/callback) ──────────
AMAZON_APP_ID=                    # amzn1.sellerapps.app....
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_APP_DRAFT=true             # adds version=beta while the app is unpublished

# ── ONDC seller app (see docs/ondc.md) ───────────────────────────────────────
ONDC_ENV=preprod                  # preprod | prod
ONDC_SUBSCRIBER_ID=               # your domain, e.g. onboarder.store
# Generate with: pnpm ondc:keys
ONDC_UNIQUE_KEY_ID=
ONDC_REQUEST_ID=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PUBLIC_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
# Only for local testing against a mock buyer app. Never set in production.
# ONDC_VERIFY_SIGNATURES=false

# Only needed when running `pnpm ondc:subscribe`:
# ONDC_LEGAL_NAME=
# ONDC_BUSINESS_ADDRESS=
# ONDC_GSTIN=
# ONDC_PAN=
# ONDC_DATE_OF_INCORPORATION=     # DD/MM/YYYY
# ONDC_SIGNATORY_NAME=
# ONDC_CONTACT_EMAIL=
# ONDC_CONTACT_PHONE=
# ONDC_DOMAINS=ONDC:RET10,ONDC:RET12,ONDC:RET13,ONDC:RET16
# ONDC_CITIES=*

# ── Analytics ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_VISITORS_TOKEN=     # visitors.now site token (production only)
